# Copy to .env and replace every value. Keep passwords to letters and digits
# (they are embedded in database connection URLs).

# Public URL users open in the browser (used for CORS). Include the port if it is not 80.
PUBLIC_URL=http://localhost
HTTP_PORT=80
APP_VERSION=latest

# PostgreSQL schema owner (migrations) and the non-owner app role (Row-Level Security applies).
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app

# At least 32 random characters.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Creates the platform admin on the first start; safe to leave on (skips once the admin exists).
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
# true also adds two sample tenants, a tenant admin and six devices. Use false on production.
SEED_SAMPLE_DATA=true

API_WORKERS=2

# Syncfusion license key (written into app-config.json when the frontend container starts).
SYNCFUSION_LICENSE=
