# App connects as a non-owner role so PostgreSQL Row-Level Security applies.
DATABASE_URL=postgresql+asyncpg://inventory_app:change-me-app@127.0.0.1:5434/inventory
# Migrations and seed run as the schema owner.
MIGRATION_DATABASE_URL=postgresql+asyncpg://inventory_owner:inventory_owner_dev@127.0.0.1:5434/inventory
APP_DB_PASSWORD=change-me-app

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:4200

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
